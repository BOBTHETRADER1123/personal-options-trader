# Copy this file to .env in the personal-options-trader folder for Windows.
# On RamNaym, enter variables in private server settings; never upload .env.
# NEVER commit .env. Never put secrets in frontend VITE_ variables.

ENVIRONMENT=development
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
SESSION_HOURS=12

# Required for first owner setup when ENVIRONMENT=production. Use a random value.
SETUP_TOKEN=
# Optional owner-login authenticator factor. Broker TOTP is configured separately.
OWNER_TOTP_SECRET=

# LOCAL: leave these commented to use project-local SQLite and data directory.
# Render or another host with temporary storage: use PostgreSQL, retaining TLS.
# Current RamNaym persistent SQLite setup: see docs/RAMNAYM-TRIAL.md.
# DATABASE_URL=postgresql://ROLE:PASSWORD@ACTUAL-HOST/ACTUAL-DATABASE?sslmode=require&channel_binding=require
# DATA_DIR=C:/Users/YOUR-NAME/Documents/PaperTrading/ServerData
# EXPORT_ROOT=C:/Users/YOUR-NAME/Documents/PaperTrading/ServerReports

# Optional absolute paths. Do not set these to an empty string.
# INSTRUMENT_MASTER_PATH=C:/Users/YOUR-NAME/Documents/PaperTrading/instruments.json
# MARKET_CALENDAR_PATH=C:/Users/YOUR-NAME/Documents/PaperTrading/market-calendar.json
# Copy exact Kotak contract IDs from the imported live master. An empty list
# subscribes only selected views and open/pending paper positions, never all contracts.
FEED_INSTRUMENT_IDS=

# Broker secrets are encrypted in the private database using a separate key.
# Generate once with cryptography.fernet.Fernet.generate_key(); preserve securely.
BROKER_CREDENTIAL_KEY=
# Kotak Neo is the only enabled read-only market-data integration.
# Retired broker credentials are not required for this deployment.

# Kotak current SFeed: either validated daily SID+UCC, or full TOTP login below.
KOTAK_UCC=
KOTAK_SID=
KOTAK_CONSUMER_KEY=
KOTAK_MOBILE_NUMBER=
KOTAK_MPIN=
KOTAK_TOTP=
# Optional backend-only authenticator secret instead of KOTAK_TOTP.
KOTAK_TOTP_SECRET=

# Pair the laptop companion with companion/configure.py. Put its displayed
# SHA256 hash here, not its raw token. Raw token stays on your laptop.
COMPANION_TOKEN_SHA256=

# Practice/live data mode, charges, logging and optional archive deletion are
# persistent app Settings. Real broker order execution is absent from this app.

# Current production target: verified local RamNaym volume, one ASGI worker.
# DATA_DIR=/app/data
# DATABASE_URL=sqlite:////app/data/trading.db
# SQLITE_JOURNAL_MODE=DELETE
# GUNICORN_WORKERS=1
# WEB_CONCURRENCY=1
PERSISTENT_STORAGE_LIMIT_GB=15
GOOGLE_SHEETS_SYNC_ENABLED=false
GOOGLE_SHEETS_SYNC_SECONDS=5
GOOGLE_SHEETS_BATCH_SNAPSHOTS=300
GOOGLE_SHEETS_MAX_CELLS=9000000

# App-owned OAuth: select your separate 15GB Google account during consent.
# Uses drive.file only. External Testing refresh tokens expire after seven days.
# A changed account keeps old remote files in their original account.
GOOGLE_DRIVE_BACKUP_ENABLED=false
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=https://personal-options-trader.vercel.app/api/cloud/drive/callback
GOOGLE_DRIVE_TOKEN_KEY=
DRIVE_SPOOL_MAX_MB=256
DRIVE_MAX_FILE_MB=64
DRIVE_MIN_FREE_MB=512
DRIVE_MAX_PENDING_JOBS=1000
RESOURCE_SAMPLE_SECONDS=30
RESOURCE_CPU_WARNING_PERCENT=75
RESOURCE_CPU_CRITICAL_PERCENT=90
RESOURCE_RAM_WARNING_PERCENT=75
RESOURCE_RAM_CRITICAL_PERCENT=90
RESOURCE_DISK_WARNING_PERCENT=75
RESOURCE_DISK_CRITICAL_PERCENT=95
DAILY_EXPORT_MAX_CELLS=1000000
DAILY_EXPORT_MAX_FILE_MB=64
# Export thread CPU target; cooperative, so short compression bursts can exceed it.
DAILY_EXPORT_CPU_PERCENT=35

# Automatic verified Google archival: 12 GiB trigger, 10 GiB target.
# Enable only after Google authorization/upload verification. Older finalized
# snapshot details only; preserves account/active state, anchors and exports.
# Runs bounded cleanup outside recording; SQLite frees pages for reuse, not
# an automatic file shrink. Google failure leaves source records intact.
AUTO_ARCHIVE_ENABLED=false
AUTO_ARCHIVE_TRIGGER_GB=12
AUTO_ARCHIVE_TARGET_GB=10
AUTO_ARCHIVE_INTERVAL_SECONDS=60
