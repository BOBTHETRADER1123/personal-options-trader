# Optional frontend-only configuration. All VITE_ values are visible publicly.
# Local dev: leave API URL empty; Vite proxies /api to the local FastAPI backend.
# Vercel: leave API URL empty; frontend/vercel.json proxies /api to Render.
VITE_API_BASE_URL=
# Vercel only: replace the service hostname below with your actual Render URL.
# Leave unset for local development. Session auth uses a one-use backend ticket.
# VITE_WS_URL=wss://YOUR-ACTUAL-RENDER-SERVICE.onrender.com/ws
