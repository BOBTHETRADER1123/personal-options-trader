# Frontend-only values are public and are embedded when Vite builds the website.
# Local development: leave these unset; Vite proxies /api and /api/ws to FastAPI.
# Vercel: leave API URL empty; frontend/vercel.json proxies HTTP /api to RamNaym.
VITE_API_BASE_URL=
# Vercel Production and Preview build setting (WebSockets bypass the HTTP proxy):
# VITE_WS_URL=wss://libzw8xd976f.ramnaymcloud.com/ws
# Set VITE_WS_URL before building/redeploying Vercel; a runtime-only change cannot
# update an already-built JavaScript bundle. Do not put keys or tokens here.
