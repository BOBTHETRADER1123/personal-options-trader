# Reference only. install.sh creates the private file with a fresh setup token.
# Never copy the Windows .env, Neon URL, or session data into this template.
ENVIRONMENT=production
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
SESSION_HOURS=12
ALLOWED_ORIGINS=https://REQUIRED_PUBLIC_HOSTNAME,https://personal-options-trader.vercel.app
DATABASE_URL=sqlite:////var/lib/personal-options-trader/trader.db
DATA_DIR=/var/lib/personal-options-trader
INSTRUMENT_MASTER_PATH=/var/lib/personal-options-trader/instruments.json
MARKET_CALENDAR_PATH=/var/lib/personal-options-trader/market-calendar.json
EXPORT_ROOT=/var/lib/personal-options-trader/reports
SETUP_TOKEN=GENERATED_ONLY_IN_THE_PRIVATE_SERVER_FILE
OWNER_TOTP_SECRET=
COMPANION_TOKEN_SHA256=
FEED_INSTRUMENT_IDS=
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
FIVEPAISA_CLIENT_CODE=
FIVEPAISA_ACCESS_TOKEN=
KOTAK_UCC=
KOTAK_SID=
KOTAK_CONSUMER_KEY=
KOTAK_MOBILE_NUMBER=
KOTAK_MPIN=
KOTAK_TOTP=
KOTAK_TOTP_SECRET=
# Limits stop new backups; existing archives are never deleted automatically.
BACKUP_MAX_FILES=30
BACKUP_MAX_BYTES=1073741824
BACKUP_MIN_FREE_BYTES=2147483648
