# Allow only backend runtime files and the explicit startup wrapper.
**
!Dockerfile
!.dockerignore
!backend/
!backend/requirements.txt
!backend/requirements-brokers.txt
!backend/alembic.ini
!backend/app/
!backend/app/**
!backend/migrations/
!backend/migrations/**
!backend/calendars/
!backend/calendars/**
!deploy/
!deploy/ramnaym/
!deploy/ramnaym/main.py
!deploy/ramnaym/runtime.py
!deploy/ramnaym/safe_worker.py
!deploy/ramnaym/gunicorn_conf.py
!deploy/ramnaym/start.py
**/__pycache__/
**/*.pyc
**/.env
**/.env.*
**/*.db
**/*.sqlite3
**/*.xlsx
